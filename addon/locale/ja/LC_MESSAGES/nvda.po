#. Translators: label of a menu item
#: addon\globalPlugins\sonata_tts_global_plugin\__init__.py:47
msgid "Sonata &voice manager..."
msgstr "Sonata 音声マネージャー(&V)..."

#. Translators: Sonata's voice manager menu item help
#: addon\globalPlugins\sonata_tts_global_plugin\__init__.py:49
msgid "Open the voice manager to preview, install or download sonata voices"
msgstr "Sonata 音声マネージャーを開いて、音声のプレビュー、インストール、ダウンロードを行います"

#: addon\globalPlugins\sonata_tts_global_plugin\__init__.py:65
msgid ""
"No Sonata voice was found.\n"
"You can preview and download voices from the voice manager.\n"
"Do you want to open the voice manager now?"
msgstr ""
"Sonata の音声が見つかりませんでした。\n"
"音声マネージャーから音声のプレビューとダウンロードが可能です。\n"
"今すぐ音声マネージャーを開きますか？"

#. Translators: title of a message telling the user that no Sonata voice was
#. found
#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on
#. to be shown on installation and add-on information found in Add-ons
#. Manager.
#: addon\globalPlugins\sonata_tts_global_plugin\__init__.py:70 buildVars.py:23
msgid "Sonata Neural Voices"
msgstr "Sonata Neural Voices"

#. Translators: the label of the OK button in a dialog
#: addon\globalPlugins\sonata_tts_global_plugin\components.py:86
msgid "OK"
msgstr "OK"

#. Translators: the label of the cancel button in a dialog
#: addon\globalPlugins\sonata_tts_global_plugin\components.py:89
msgid "Cancel"
msgstr "キャンセル"

#. Translators: message of a progress dialog
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:192
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:329
msgid "Downloaded: {progress}%"
msgstr "ダウンロード済み: {progress}%"

#. Translators: message shown in the voice download progress dialog
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:201
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:338
msgid "Installing voice"
msgstr "音声をインストール中"

#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:230
msgid ""
"Successfully downloaded voice  {voice}.\n"
"To use this voice, you need to restart NVDA.\n"
"Do you want to restart NVDA now?"
msgstr ""
"音声 {voice} のダウンロードに成功しました。\n"
"この音声を使用するにはNVDAを再起動する必要があります。\n"
"今すぐ再起動しますか？"

#. Translators: title of a message box
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:237
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:361
msgid "Voice downloaded"
msgstr "音声のダウンロード完了"

#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:246
msgid ""
"Cannot download voice {voice}.\n"
"Please check your connection and try again."
msgstr ""
"音声 {voice} をダウンロードできませんでした。\n"
"インターネット接続を確認して再試行してください。"

#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:248
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:372
msgid "Download failed"
msgstr "ダウンロード失敗"

#. Translators: title of a progress dialog
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:258
msgid "Downloading voice {voice}"
msgstr "音声 {voice} をダウンロード中"

#. Translators: message of a progress dialog
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:262
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:386
msgid "Retrieving download information..."
msgstr "ダウンロード情報を取得中..."

#. Translators: message shown in progress dialog
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:274
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:397
msgid "Downloading file: {file}"
msgstr "ファイルをダウンロード中: {file}"

#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:354
msgid ""
"Successfully downloaded fast variant of the voice  {voice}.\n"
"To use this voice, you need to restart NVDA.\n"
"Do you want to restart NVDA now?"
msgstr ""
"音声 {voice} の軽量（Fast）バリアントのダウンロードに成功しました。\n"
"この音声を使用するにはNVDAを再起動する必要があります。\n"
"今すぐ再起動しますか？"

#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:370
msgid ""
"Cannot download fast variant of the voice {voice}.\n"
"Please check your connection and try again."
msgstr ""
"音声 {voice} の軽量（Fast）バリアントをダウンロードできませんでした。\n"
"インターネット接続を確認して再試行してください。"

#. Translators: title of a progress dialog
#: addon\globalPlugins\sonata_tts_global_plugin\voice_download.py:382
msgid "Downloading fast variant of the voice {voice}"
msgstr "音声 {voice} の軽量（Fast）バリアントをダウンロード中"

